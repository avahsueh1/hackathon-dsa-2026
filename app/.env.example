# The app already points at the backend repo's live Supabase project, so it
# works with no .env at all. These only matter if you need to override it.

# Project URL and publishable ("anon") key.
# Supabase dashboard -> Project Settings -> API. Never the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to 1 to force the offline localStorage path -- handy if venue wifi
# blocks outbound and the demo has to keep working.
VITE_SUPABASE_OFFLINE=
